{
  "name": "skills-framework",
  "private": true,
  "description": "Disciplined skillset reference deck and framework",
  "scripts": {
    "build:deck": "node scripts/build-deck.mjs",
    "build:graph": "node scripts/build-graph.mjs",
    "build:guides": "node scripts/build-guides.mjs",
    "build:chrome": "node scripts/build-chrome.mjs",
    "build": "node scripts/build-deck.mjs && node scripts/build-graph.mjs && node scripts/build-guides.mjs && node scripts/build-situation-finder.mjs && node scripts/build-executive-scan.mjs && node scripts/build-chrome.mjs && node scripts/validate-cards.mjs --strict && node scripts/generate-ai-index.mjs && node scripts/check-counts.mjs",
    "build:cowork": "node scripts/build-cowork-skills.mjs",
    "validate:cowork": "node scripts/validate-cowork-skills.mjs",
    "validate:cards": "node scripts/validate-cards.mjs",
    "validate:frontmatter": "node scripts/validate-cards.mjs --strict",
    "derive:refs": "node scripts/derive-refs.mjs",
    "reconcile:refs": "node scripts/reconcile-refs.mjs",
    "generate:ai-index": "node scripts/generate-ai-index.mjs",
    "build:situation-finder": "node scripts/build-situation-finder.mjs",
    "build:executive-scan": "node scripts/build-executive-scan.mjs",
    "snapshot:test": "node scripts/snapshot-test.mjs",
    "test:parse-skill": "node scripts/lib/parse-skill.test.mjs",
    "test:frontmatter": "node scripts/lib/frontmatter.test.mjs",
    "migrate:frontmatter": "node scripts/archive/migrate-frontmatter.mjs",
    "check:counts": "node scripts/check-counts.mjs"
  },
  "dependencies": {
    "mdast-util-to-string": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0"
  }
}
